# Groq API Key (Used for fast difficulty classifier & cheap LLM tier)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Used for capable LLM tier)
GEMINI_API_KEY=your_gemini_api_key_here

# n8n Webhook URL (for local self-hosted n8n instance)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/route-demo

# Model Tier Configurations
FAST_MODEL=openai/gpt-oss-120b
ROUTER_MODEL=openai/gpt-oss-20b
CAPABLE_MODEL=gemini-3.1-flash-lite
