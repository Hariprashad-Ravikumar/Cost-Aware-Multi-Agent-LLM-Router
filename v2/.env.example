# Existing tier keys (reused from v1)
GEMINI_API_KEY=your_gemini_api_key_here

# v2's multi-tier ladder keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Tier ladder (cheap -> mid -> capable), escalated only when the calibrator predicts the
# lower tier is likely wrong under the configured ERROR_BUDGET.
# Cheap tier moved from Groq to OpenAI after Groq's free-tier rate limit (8000
# tokens/min on openai/gpt-oss-120b) made bulk calibration data collection impractical,
# and because Groq's model didn't support logprobs (OpenAI's does) - see CASE_STUDY.md.
# Mid/capable swapped from the original assignment: Claude Haiku 4.5 was priced ABOVE
# Gemini 3.1 Flash-Lite, inverting the tier ladder's cost ordering - see CASE_STUDY.md.
CHEAP_MODEL=gpt-5.4-nano
MID_MODEL=gemini-3.1-flash-lite
CAPABLE_MODEL=claude-sonnet-5

# Infra
DATABASE_URL=postgresql://router:router@localhost:5432/router
REDIS_URL=redis://localhost:6379/0

# Routing policy
ERROR_BUDGET=0.15
CACHE_TTL_SECONDS=3600
